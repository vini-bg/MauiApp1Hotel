<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Hotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource White}">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="10">
        <Label 
            Text="Cálculo da Diária"
            FontFamily="Outfit"
            FontSize="45"
            TextColor="{StaticResource MidnightBlue}"/>
        
    <!-- Substituto de Frame -->
        <Border Padding="10" BackgroundColor="CornflowerBlue">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">
                    <Label Grid.Row="0" Grid.Column="0"
                           TextColor="White"
                           Text="Adultos: "/>
                    
                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="White"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>
                    
                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="White"/>
                    
                    <Label Grid.Row="1" Grid.Column="0"
                           TextColor="White"
                           Text="Crianças: "/>

                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"
                           TextColor="White"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="White"/>

                </Grid>

                <Label Text="Escolha sua Suíte" />
                
                <Picker x:Name="pck_quarto"
                        Title="Selecione sua acomodação"
                        BackgroundColor="White"/>

                <Border Padding="10"
                        Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Período de Estadia"
                               FontFamily="Outfit"
                               FontSize="20"
                               TextColor="White"/>
                        <HorizontalStackLayout>
                            <Label Text="Check-in: "/>
                            <DatePicker x:Name="dtcpk_checkin"
                                        Format="dd/MM/yyyy" 
                                        BackgroundColor="White"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="Check-out: "/>
                            <DatePicker x:Name="dtcpk_checkout"
                                        Format="dd/MM/yyyy" 
                                        BackgroundColor="White"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </Border>

                <VerticalStackLayout 
                    Spacing="10">
                    
                    <Button Text="Avançar" BackgroundColor="Green"/>

                    <Button Text="Sobre" BackgroundColor="Grey"
                            Clicked="OnButtonClicked" />

                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </Border>
        
    </VerticalStackLayout>
    
</ContentPage>